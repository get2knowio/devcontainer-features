{
    "id": "ai-clis",
    "version": "1.0.0",
    "name": "AI CLI Tools",
    "documentationURL": "https://github.com/get2knowio/devcontainer/tree/main/src/ai-clis",
    "description": "Installs popular AI coding assistant CLIs: Claude Code, Gemini CLI, OpenAI Codex, GitHub Copilot, OpenCode, and CodeRabbit.",
    "options": {
        "claudeCode": {
            "type": "boolean",
            "default": true,
            "description": "Install Claude Code CLI"
        },
        "geminiCli": {
            "type": "boolean",
            "default": true,
            "description": "Install Google Gemini CLI"
        },
        "codex": {
            "type": "boolean",
            "default": true,
            "description": "Install OpenAI Codex CLI"
        },
        "copilot": {
            "type": "boolean",
            "default": true,
            "description": "Install GitHub Copilot CLI"
        },
        "openCode": {
            "type": "boolean",
            "default": true,
            "description": "Install OpenCode AI CLI"
        },
        "codeRabbit": {
            "type": "boolean",
            "default": true,
            "description": "Install CodeRabbit CLI"
        }
    },
    "installsAfter": [
        "ghcr.io/devcontainers/features/node"
    ]
}
