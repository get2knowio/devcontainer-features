{
    "typescript_only": {
        "image": "mcr.microsoft.com/devcontainers/base:ubuntu",
        "features": {
            "ghcr.io/devcontainers/features/node:1": {},
            "node-dev-tools": {
                "install": "typescript"
            }
        }
    },
    "no_bun": {
        "image": "mcr.microsoft.com/devcontainers/base:ubuntu",
        "features": {
            "ghcr.io/devcontainers/features/node:1": {},
            "node-dev-tools": {
                "omit": "bun"
            }
        }
    }
}
