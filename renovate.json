{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":semanticCommits"
  ],
  "configMigration": true,
  "labels": [
    "dependencies",
    "devcontainer"
  ],
  "prHourlyLimit": 2,
  "prConcurrentLimit": 10,
  "timezone": "UTC",
  "pinDigests": true,
  "schedule": [
    "before 6am on monday"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^src/github-actions-tools/devcontainer-feature\\.json$/"
      ],
      "matchStrings": [
        "\"actVersion\":\\s*\\{[^}]*\"default\":\\s*\"(?<currentValue>\\d+\\.\\d+\\.\\d+)\""
      ],
      "depNameTemplate": "nektos/act",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v?(?<version>.*)$"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^src/github-actions-tools/devcontainer-feature\\.json$/"
      ],
      "matchStrings": [
        "\"actionlintVersion\":\\s*\\{[^}]*\"default\":\\s*\"(?<currentValue>\\d+\\.\\d+\\.\\d+)\""
      ],
      "depNameTemplate": "rhysd/actionlint",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v?(?<version>.*)$"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^src/modern-cli-tools/devcontainer-feature\\.json$/"
      ],
      "matchStrings": [
        "\"lazygitVersion\":\\s*\\{[^}]*\"default\":\\s*\"(?<currentValue>\\d+\\.\\d+\\.\\d+)\""
      ],
      "depNameTemplate": "jesseduffield/lazygit",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v?(?<version>.*)$"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^src/modern-cli-tools/devcontainer-feature\\.json$/"
      ],
      "matchStrings": [
        "\"astGrepVersion\":\\s*\\{[^}]*\"default\":\\s*\"(?<currentValue>\\d+\\.\\d+\\.\\d+)\""
      ],
      "depNameTemplate": "ast-grep/ast-grep",
      "datasourceTemplate": "github-releases"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^src/modern-cli-tools/devcontainer-feature\\.json$/"
      ],
      "matchStrings": [
        "\"zellijVersion\":\\s*\\{[^}]*\"default\":\\s*\"(?<currentValue>\\d+\\.\\d+\\.\\d+)\""
      ],
      "depNameTemplate": "zellij-org/zellij",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v?(?<version>.*)$"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^src/python-tools/devcontainer-feature\\.json$/"
      ],
      "matchStrings": [
        "\"poetryVersion\":\\s*\\{[^}]*\"default\":\\s*\"(?<currentValue>\\d+\\.\\d+\\.\\d+)\""
      ],
      "depNameTemplate": "python-poetry/poetry",
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "semver"
    }
  ],
  "packageRules": [
    {
      "matchDatasources": [
        "github-releases"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "groupName": "major devcontainer tooling upgrades",
      "labels": [
        "dependencies",
        "devcontainer",
        "tooling",
        "major"
      ],
      "schedule": [
        "before 6am on monday"
      ],
      "automerge": false
    },
    {
      "matchDatasources": [
        "github-releases"
      ],
      "matchUpdateTypes": [
        "minor"
      ],
      "groupName": "minor devcontainer tooling updates",
      "labels": [
        "dependencies",
        "devcontainer",
        "tooling",
        "minor"
      ],
      "schedule": [
        "before 6am on monday"
      ],
      "automerge": false
    },
    {
      "matchDatasources": [
        "github-releases"
      ],
      "matchUpdateTypes": [
        "patch"
      ],
      "groupName": "patch devcontainer tooling updates",
      "labels": [
        "dependencies",
        "devcontainer",
        "tooling",
        "patch",
        "automerge"
      ],
      "schedule": [
        "before 6am on monday"
      ],
      "automerge": true,
      "automergeType": "pr"
    }
  ]
}
